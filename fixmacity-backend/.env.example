# ── FixMaCity Backend — Environment Variables ──────────────────
# Copy to .env and fill in your values

PORT=5005
NODE_ENV=development

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=YOUR_SECRET_HERE
JWT_EXPIRES_IN=7d

# ── Local PostgreSQL (pgAdmin) ─────────────────────────────────
# 1. Open pgAdmin → right-click "Databases" → Create → name it "fixmacity"
# 2. Open Query Tool on that database and run schema.sql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fixmacity
DB_USER=postgres
DB_PASSWORD=YOUR_DB_PASSWORD
DB_POOL_MAX=10

BASE_URL=http://localhost:5000
# ── Cloudinary (photo uploads) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google Gemini (chatbot AI) ────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ── Frontend origin (CORS + email links) ─────────────────────
FRONTEND_URL=http://localhost:5174

# ── Email / Nodemailer ────────────────────────────────────────
# If unset, emails are silently skipped — safe for local dev.
# For Gmail: Account → Security → 2FA → App Passwords
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=

SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_KEY
