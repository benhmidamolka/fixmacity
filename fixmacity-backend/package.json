{
  "name": "fixmacity-backend",
  "version": "1.0.0",
  "description": "Backend API for FixMaCity — Municipal citizen request platform for Sousse, Tunisia",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "predev": "powershell -Command \"$p = Get-NetTCPConnection -LocalPort 5005 -ErrorAction SilentlyContinue; if ($p) { Stop-Process -Id $p.OwningProcess -Force -ErrorAction SilentlyContinue }; exit 0\"",
    "dev": "nodemon server.js",
    "ai": "py -m g4f.api.run"
  },
  "keywords": [
    "municipality",
    "sousse",
    "civic",
    "api"
  ],
  "author": "FixMaCity",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.5",
    "pdfkit": "^0.18.0",
    "pg": "^8.13.3",
    "resend": "^6.12.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "axios": "^1.15.2",
    "form-data": "^4.0.5",
    "nodemon": "^3.1.9"
  }
}
